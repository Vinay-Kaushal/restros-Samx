# Supabase Postgres connection strings — you need BOTH:
#
# DATABASE_URL: the POOLED connection (port 6543, via pgbouncer). The running
# app uses this for normal queries. From Supabase: Project Settings ->
# Database -> Connection string -> "Transaction" mode.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# DIRECT_URL: the DIRECT connection (port 5432, no pooler). Prisma Migrate
# uses this one specifically - migrations hang or fail through the pooler
# because it doesn't support the session features (advisory locks, prepared
# statements) that schema migrations rely on. From Supabase: same page,
# "Session" mode or "Direct connection".
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Upstash (or any) Redis - used for demand counters, pub/sub, and BullMQ
REDIS_URL="redis://default:password@xxxx.upstash.io:6379"

PORT=4000

# Phase 2
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OTP provider (Twilio/MSG91) - wired in Phase 2
SMS_PROVIDER_API_KEY=""
